{
  "schema": "web-ui-page/1",
  "title": "TopOntoLogy 利用ガイド",
  "theme": "modern",
  "description": "Topology（構造とつながり）と Ontology（意味と概念の体系）の対応を探るプロジェクト。関係の意味ごとに、グラフの構造を調べます。",
  "icon": "./icon.png",
  "favicon": "./favicon.png",
  "blocks": [
    {
      "type": "badges",
      "items": [
        "🧭 構造を調べる",
        "🔒 読み取り専用・ネットワークに出ない",
        "🐍 Python 3.11+"
      ]
    },
    {
      "type": "tabs",
      "id": "guide",
      "tabs": [
        {
          "label": "🧩 機能一覧",
          "blocks": [
            {
              "type": "section",
              "title": "📥 取得",
              "blocks": [
                {
                  "type": "text",
                  "text": "Python 3.11+ と git が必要です。ONTO・TaxOntOy・OnTautoLogy を隣のフォルダに置くと、場所を自動で見つけます。"
                },
                {
                  "type": "output",
                  "text": "git clone https://github.com/myon-bioinformatics/TopOntoLogy.git\ncd TopOntoLogy"
                }
              ]
            },
            {
              "type": "section",
              "title": "▶️ 実行",
              "blocks": [
                {
                  "type": "card",
                  "title": "🔎 グラフを調べる",
                  "text": "位置引数は「グラフ プロファイル」です。分類表を省くと TaxOntOy の otl-relations.json を使います。",
                  "blocks": [
                    {
                      "type": "output",
                      "text": "$ python -S topontology.py audit.json audit"
                    },
                    {
                      "type": "output",
                      "text": "$ python -S topontology.py audit.json audit --format text"
                    }
                  ]
                },
                {
                  "type": "card",
                  "title": "↔️ 前後を比べる",
                  "text": "2つのグラフの差を見ます。",
                  "blocks": [
                    {
                      "type": "output",
                      "text": "$ python -S topontology.py before.json concepts --compare after.json"
                    }
                  ]
                },
                {
                  "type": "card",
                  "title": "🧜 図にする",
                  "text": "分類を選んで Mermaid で出します。",
                  "blocks": [
                    {
                      "type": "output",
                      "text": "$ python -S topontology.py audit.json concepts --format mermaid --class hierarchy"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "🔬 検証ガイド",
          "blocks": [
            {
              "type": "runbook",
              "id": "verify",
              "books": [
                {
                  "label": "🐍 python",
                  "intro": "🤖 のついた手順は CI で実際に動かし、出た結果をそのまま載せています。",
                  "runbook": {
                    "key": "topontology/python",
                    "steps": [
                      {
                        "id": "get",
                        "title": "📥 ファイルを置く",
                        "command": "curl -fsSLO https://raw.githubusercontent.com/myon-bioinformatics/TopOntoLogy/main/topontology.py",
                        "needs": "🌐 ネットワーク"
                      },
                      {
                        "id": "deps",
                        "title": "📥 ONTO と OnTautoLogy を隣に置く",
                        "command": "[ -d ../ONTO ] || git clone -q --depth 1 https://github.com/myon-bioinformatics/ONTO ../ONTO\n[ -d ../OnTautoLogy ] || git clone -q --depth 1 https://github.com/myon-bioinformatics/OnTautoLogy ../OnTautoLogy",
                        "needs": "🌐 ネットワーク",
                        "run": true
                      },
                      {
                        "id": "help",
                        "title": "❓ ヘルプ",
                        "command": "ONTO_ROOT=../ONTO OTL_ROOT=../OnTautoLogy python -S topontology.py --help",
                        "run": true
                      },
                      {
                        "id": "audit",
                        "title": "🔎 グラフを調べる",
                        "command": "ONTO_ROOT=../ONTO OTL_ROOT=../OnTautoLogy python -S topontology.py audit.json audit --format text",
                        "needs": "📝 入力ファイル"
                      }
                    ]
                  }
                },
                {
                  "label": "⚡ uv",
                  "intro": "uv があれば Python の版を気にせず動きます。",
                  "runbook": {
                    "key": "topontology/uv",
                    "steps": [
                      {
                        "id": "get",
                        "title": "📥 ファイルを置く",
                        "command": "curl -fsSLO https://raw.githubusercontent.com/myon-bioinformatics/TopOntoLogy/main/topontology.py",
                        "needs": "🌐 ネットワーク"
                      },
                      {
                        "id": "deps",
                        "title": "📥 ONTO と OnTautoLogy を隣に置く",
                        "command": "[ -d ../ONTO ] || git clone -q --depth 1 https://github.com/myon-bioinformatics/ONTO ../ONTO\n[ -d ../OnTautoLogy ] || git clone -q --depth 1 https://github.com/myon-bioinformatics/OnTautoLogy ../OnTautoLogy",
                        "needs": "🌐 ネットワーク",
                        "run": true
                      },
                      {
                        "id": "help",
                        "title": "❓ ヘルプ",
                        "command": "ONTO_ROOT=../ONTO OTL_ROOT=../OnTautoLogy uv run --no-project python -S topontology.py --help",
                        "run": true
                      }
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "label": "🎞 GIF デモ",
          "blocks": [
            {
              "type": "text",
              "text": "🎞 まだ GIF はありません。ブラウザテストや実行の様子を GIF にしたら、ここに並びます。",
              "muted": true
            }
          ]
        }
      ]
    },
    {
      "type": "section",
      "title": "🔗 リンク",
      "blocks": [
        {
          "type": "links",
          "items": [
            {
              "label": "📦 リポジトリ",
              "href": "https://github.com/myon-bioinformatics/TopOntoLogy"
            },
            {
              "label": "📖 README",
              "href": "https://github.com/myon-bioinformatics/TopOntoLogy#readme"
            },
            {
              "label": "📄 topontology.py",
              "href": "https://github.com/myon-bioinformatics/TopOntoLogy/blob/main/topontology.py"
            },
            {
              "label": "🗂️ TaxOntOy",
              "href": "https://github.com/myon-bioinformatics/TaxOntOy"
            },
            {
              "label": "🧱 ONTO",
              "href": "https://github.com/myon-bioinformatics/ONTO"
            }
          ]
        }
      ]
    }
  ]
}
